{
  "name": "js-labs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:client": "node scripts/test-m1.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit -p .",
    "benchmark:simulation": "node --experimental-strip-types server/benchmarks/benchmark-simulation.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.53.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "^5.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "fast-check": "^4.11.0",
    "playwright": "^1.53.1",
    "prettier": "^3.9.9",
    "typescript": "^5.8.0",
    "vite": "^8.2.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  }
}
